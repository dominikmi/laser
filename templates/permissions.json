{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "websearch": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -r *": "deny",
      "rmdir *": "deny",
      "sudo *": "deny",
      "curl * | *": "deny",
      "wget * | *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "mv /* *": "deny",
      "cp /* *": "deny",
      "kill *": "deny",
      "pkill *": "deny",
      "shutdown *": "deny",
      "reboot *": "deny"
    },
    "edit": {
      "*": "deny",
      ".security-output/*": "allow"
    }
  }
}
