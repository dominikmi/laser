, note_id)\n        if note is None:\n            flash('Note not found', 'warning')\n        else:\n            session.delete(note)\n            session.commit()\n\n    flash('Note deleted', 'info')\n    return redirect('/home')","lineStart":1,"lineEnd":52,"totalLines":52,"truncated":false}},"title":"routes/notes.py","time":{"start":1788164915648,"end":1788164915654}},"id":"prt_056ef41bc0011Ig6A0H25Y3CSQ","sessionID":"ses_fa923204fffeJOVYIIzNA2JDJK","messageID":"msg_056ef160e001VgHIhY5cIHf7Wv"}}
