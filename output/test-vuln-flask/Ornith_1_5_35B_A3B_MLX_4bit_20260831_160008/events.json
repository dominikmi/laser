om models import RegistrationCode, Session\n\n\n@app.route('/registration-codes', methods=['GET'])\n@login_required\ndef registration_codes():\n    if not current_user.is_admin:\n        flash(\"Not authorized to access this page\", 'error')\n        return redirect('/home')\n\n    with Session() as session:\n        codes = session.query(RegistrationCode).all()","truncated":false,"loaded":[],"display":{"type":"file","path":"/Users/mikey/HomeWorks/OpenCode-tests/test-vuln-flask/routes/registration_codes.py","text":"#!/usr/bin/env python3\n\nfrom uuid import uuid4\n\nfrom flask_login import login_required, current_user\nfrom flask import (render_template, redirect, flash)\n\nfrom app import app\nfrom models import RegistrationCode, Session\n\n\n@app.route('/registration-codes', methods=['GET'])\n@login_required\ndef registration_codes():\n    if not current_user.is_admin:\n        flash(\"Not authorized to access this page\", 'error')\n        return redirect('/home')\n\n    with Session() as session:\n        codes = session.query(RegistrationCode).all()\n\n        return render_template('registration_codes.html',\n                               registration_codes=codes)\n\n\n@app.route('/registration-codes', methods=['POST'])\n@login_required\ndef add_registration_codes():\n    if not current_user.is_admin:\n        flash(\"Not authorized to create new registration codes\", 'error')\n        return redirect('/home')\n\n    with Session(expire_on_commit=False) as session:\n        code = RegistrationCode(str(uuid4()))\n        session.add(code)\n        session.commit()\n\n    flash(f\"Code added: {code.code}\", 'success')\n    return redirect('/registration-codes')","lineStart":1,"lineEnd":39,"totalLines":39,"truncated":false}},"title":"routes/registration_codes.py","time":{"start":1788193069252,"end":1788193069266}},"id":"prt_0589cd8bb0015ucrmcHZIgZWPm","sessionID":"ses_fa773389fffevh97Nl5ZXjkxvh","messageID":"msg_0589c6384001bepArSwCXo91SL"}}
